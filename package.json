{
  "name": "trails",
  "private": true,
  "license": "SEE LICENSE IN LICENSES.md",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "tsc --build",
    "tasks": "scripts/tasks/tasks.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "node scripts/typecheck.mjs",
    "guides:typecheck": "tsx scripts/guides-typecheck/check.ts",
    "check:closing-story-refs": "pnpm tsx scripts/closing-story-references.ts",
    "prelint": "pnpm tsx scripts/build-rails-privates-manifest.ts --allow-missing && pnpm tsx scripts/build-rails-error-manifest.ts && pnpm tsx scripts/build-rails-tosql-manifest.ts && pnpm tsx scripts/build-rails-file-structure-manifest.ts --allow-missing && pnpm tsx scripts/test-deps/rails-test-deps.ts >/dev/null",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint .",
    "prelint:files": "pnpm prelint",
    "lint:files": "NODE_OPTIONS=--max-old-space-size=6144 eslint --no-error-on-unmatched-pattern",
    "lint:no-explicit-any:allowlist": "pnpm tsx scripts/generate-no-explicit-any-allowlist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --config vitest.dx-tests.config.ts",
    "test:types:virtualized": "tsc -b packages/activerecord-cli && node packages/activerecord-cli/dist/tsc-wrapper/cli.js -p packages/activerecord/virtualized-dx-tests/tsconfig.json",
    "test:db": "ARCONN=postgresql PGHOST=localhost PGPORT=25432 PGUSER=rails MYSQL_HOST=127.0.0.1 MYSQL_PORT=13306 vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "parity:api": "bash scripts/api-compare/run.sh",
    "parity:api:drift": "pnpm tsx scripts/api-compare/drift.ts",
    "parity:api:extra": "pnpm tsx scripts/api-compare/extra-surface.ts",
    "parity:api:build": "pnpm tsx scripts/api-compare/build.ts",
    "parity:api:extra:gate": "pnpm tsx scripts/api-compare/lint-extra-surface-ratchet.ts",
    "parity:api:extra:tighten": "pnpm tsx scripts/api-compare/lint-extra-surface-ratchet.ts --tighten",
    "parity:api:reasons": "pnpm tsx scripts/api-compare/lint-missing-rails-call-reasons.ts",
    "parity:api:detached": "pnpm tsx scripts/api-compare/lint-detached-jsdoc-tags.ts",
    "parity:api:calls": "pnpm tsx scripts/api-compare/lint-call-mismatches.ts",
    "parity:api:calls:report": "pnpm tsx scripts/api-compare/lint-call-mismatches.ts --report",
    "parity:api:calls:args": "pnpm tsx scripts/api-compare/lint-call-args.ts",
    "parity:api:calls:args:report": "pnpm tsx scripts/api-compare/report-call-args.ts --report",
    "parity:api:calls:ruby-compat:report": "pnpm tsx scripts/api-compare/report-ruby-compat.ts --report",
    "parity:structural-duplicates:report": "pnpm tsx scripts/api-compare/report-structural-duplicates.ts --report",
    "parity:api:calls:args:reseed": "API_COMPARE_FORCE=1 pnpm parity:api --calls && pnpm tsx scripts/api-compare/lint-call-args.ts --write --no-regen",
    "parity:api:calls:unreviewed": "pnpm tsx scripts/api-compare/lint-call-mismatches.ts --unreviewed",
    "parity:api:arms:report": "pnpm tsx scripts/api-compare/report-arms.ts --report",
    "parity:api:calls:reseed": "API_COMPARE_FORCE=1 pnpm parity:api --calls && pnpm tsx scripts/api-compare/lint-call-mismatches.ts --write --no-regen",
    "parity:api:calls:tighten": "pnpm tsx scripts/api-compare/lint-call-mismatches.ts --tighten",
    "parity:api:params": "pnpm tsx scripts/api-compare/lint-param-names.ts",
    "parity:api:params:tighten": "pnpm tsx scripts/api-compare/lint-param-names.ts --tighten",
    "parity:api:arity": "pnpm tsx scripts/api-compare/lint-arity-excludes.ts",
    "parity:api:inheritance": "pnpm tsx scripts/api-compare/lint-inheritance-excludes.ts",
    "parity:api:pins": "pnpm tsx scripts/api-compare/lint-body-pins.ts",
    "parity:api:pins:all": "API_COMPARE_FORCE=1 pnpm parity:api && pnpm tsx scripts/api-compare/body-pins.ts --pin-all",
    "parity:api:moves": "pnpm tsx scripts/api-compare/moves.ts",
    "parity:legacy-names": "pnpm tsx scripts/parity/lint-legacy-script-names.ts",
    "parity:api:conventions": "pnpm tsx scripts/parity/conventions-doc.ts",
    "parity:api:deps": "pnpm vendor:fetch && LIB_PATHS_JSON=$(pnpm -s vendor:fetch --print-lib-paths) LOCKFILE_PATH=$PWD/vendor/sources.lock.json ruby scripts/api-compare/extract-ruby-api.rb && pnpm tsx scripts/api-compare/lint-deps.ts",
    "parity:test": "bash scripts/test-compare/run.sh",
    "parity:test:assertions": "pnpm tsx scripts/test-compare/lint-assertion-mismatches.ts",
    "parity:test:assertions:reseed": "pnpm tsx scripts/test-compare/lint-assertion-mismatches.ts --write",
    "parity:test:names:tighten": "pnpm tsx scripts/tighten-rails-test-name-parity.ts",
    "parity:test:closure": "pnpm tsx scripts/test-compare/closure-cli.ts",
    "parity:test:stubs": "pnpm parity:test -- --missing --json && pnpm tsx scripts/test-compare/generate-stubs.ts",
    "parity:fixtures": "pnpm vendor:fetch >/dev/null && pnpm tsx scripts/fixtures-compare/compare.ts",
    "parity:fixtures:models": "pnpm vendor:fetch >/dev/null && pnpm tsx scripts/fixtures-compare/compare.ts --models",
    "parity:schema": "pnpm vendor:fetch >/dev/null && pnpm tsx scripts/schema-compare/compare.ts",
    "parity:schema:reseed": "pnpm vendor:fetch >/dev/null && pnpm tsx scripts/schema-compare/compare.ts --write",
    "fixtures:adoption:inventory": "pnpm tsx scripts/fixtures-inventory/inventory.ts",
    "rails-privates:manifest": "pnpm tsx scripts/build-rails-privates-manifest.ts",
    "rails-deprecated:check": "pnpm tsx scripts/build-rails-privates-manifest.ts --check-deprecated",
    "rails-errors:manifest": "pnpm tsx scripts/build-rails-error-manifest.ts",
    "rails-tosql:manifest": "pnpm tsx scripts/build-rails-tosql-manifest.ts",
    "rails:find": "bash scripts/rails-find/run.sh",
    "test:deps": "pnpm vendor:fetch >/dev/null && pnpm tsx scripts/test-deps/rails-test-deps.ts",
    "fixture-baseline:refresh": "pnpm test:deps >/dev/null && pnpm tsx scripts/test-deps/build-fixture-baseline.ts",
    "fixture-parity-baseline:refresh": "pnpm tsx scripts/generate-fixture-parity-exclude.ts",
    "prestats:sync": "tsc --build packages/activerecord",
    "stats:sync": "pnpm tsx scripts/sync-stats/sync.ts",
    "parity:pipeline:validate": "ajv compile -s scripts/parity/pipeline/canonical/schema.schema.json -s scripts/parity/pipeline/canonical/query.schema.json --spec=draft2020",
    "parity:pipeline:schema": "pnpm tsx scripts/parity/pipeline/run.ts --type=schema",
    "parity:pipeline:query": "pnpm tsx scripts/parity/pipeline/run.ts --type=query",
    "api:compare": "pnpm parity:api",
    "api:drift": "pnpm parity:api:drift",
    "api:extra": "pnpm parity:api:extra",
    "api:extra:gate": "pnpm parity:api:extra:gate",
    "api:build": "pnpm parity:api:build",
    "api:reasons": "pnpm parity:api:reasons",
    "api:detached": "pnpm parity:api:detached",
    "api:calls": "pnpm parity:api:calls",
    "api:calls:report": "pnpm parity:api:calls:report",
    "api:calls:args": "pnpm parity:api:calls:args",
    "api:calls:args:report": "pnpm parity:api:calls:args:report",
    "api:calls:args:reseed": "pnpm parity:api:calls:args:reseed",
    "api:calls:unreviewed": "pnpm parity:api:calls:unreviewed",
    "api:calls:reseed": "pnpm parity:api:calls:reseed",
    "api:arity": "pnpm parity:api:arity",
    "api:inheritance": "pnpm parity:api:inheritance",
    "api:pins": "pnpm parity:api:pins",
    "api:pins:all": "pnpm parity:api:pins:all",
    "fixtures:compare": "pnpm parity:fixtures",
    "schema:compare": "pnpm parity:schema",
    "schema:compare:reseed": "pnpm parity:schema:reseed",
    "api:moves": "pnpm parity:api:moves",
    "api:conventions": "pnpm parity:api:conventions",
    "lint:deps": "pnpm parity:api:deps",
    "test:compare": "pnpm parity:test",
    "test:assertions:ratchet": "pnpm parity:test:assertions",
    "test:assertions:ratchet:reseed": "pnpm parity:test:assertions:reseed",
    "test:stubs": "pnpm parity:test:stubs",
    "vendor:fetch": "pnpm tsx vendor/fetch.ts"
  },
  "devDependencies": {
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/parity": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@sinonjs/fake-timers": "^15.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.18.0",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.12",
    "ajv": "^8.18.0",
    "ajv-cli": "^5.0.0",
    "diff": "^9.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.0",
    "libsql": "^0.5.29",
    "lint-staged": "^16.0.0",
    "playwright-core": "^1.60.0",
    "prettier": "3.8.1",
    "tinyglobby": "0.2.16",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "mysql2": "^3.18.2",
    "pg": "^8.19.0",
    "yaml": "^2.8.3"
  }
}
