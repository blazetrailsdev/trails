# Multipart fixture files contain CRLF line endings that must be preserved exactly.
packages/rack/test/multipart/* binary
packages/rack/test/cgi/test.gz binary
packages/actionpack/src/test-helpers/fixtures/multipart/* binary
# Byte-for-byte copies of vendor/marcel/v1.0.4/test/fixtures: magic-byte detection reads them exactly.
packages/marcel/src/test-helpers/fixtures/** binary
# Byte-for-byte copies of vendor/mini_magick/v5.2.0/spec/fixtures: ImageMagick reads them.
packages/mini-magick/src/test-helpers/fixtures/** binary

# Shell scripts must keep LF endings even on Windows checkouts; CRLF makes
# them unparseable by /usr/bin/env in Linux containers.
*.sh text eol=lf
packages/activerecord/src/test-helpers/support/schema_cache_fixtures/*.dump binary
packages/activerecord/src/test-helpers/support/marshal_compatibility_fixtures/**/*.dump binary

# Precompressed copies of vendor/rails/v8.0.2/actionpack/test/fixtures/{public,公共}.
packages/actionpack/src/test-helpers/fixtures/public/**/*.gz binary
packages/actionpack/src/test-helpers/fixtures/public/**/*.br binary
packages/actionpack/src/test-helpers/fixtures/公共/**/*.gz binary
packages/actionpack/src/test-helpers/fixtures/公共/**/*.br binary
