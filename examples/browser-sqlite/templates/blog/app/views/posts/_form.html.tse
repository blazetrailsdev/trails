<%= formWith({ model: post }, (form) => { %>
  <% if (post.errors.isAny()) { %>
    <div class="errors">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul>
        <% post.errors.each((error) => { %>
          <li><%= error.fullMessage %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="field">
    <%= form.label("title") %>
    <%= form.textField("title") %>
  </div>

  <div class="field">
    <%= form.label("body") %>
    <%= form.textArea("body", { rows: 6 }) %>
  </div>

  <div class="field">
    <%= form.checkBox("published") %> <%= form.label("published", { style: "display: inline" }) %>
  </div>

  <%= form.submit() %>
<% }) %>
