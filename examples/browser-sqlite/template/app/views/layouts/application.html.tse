<!DOCTYPE html>
<html>
  <head>
    <title><%= contentFor("title") ?? "Trail log" %> · trails</title>
    <%= csrfMetaTags() %>
    <style>
      :root {
        --surface: #1c1916; --raised: #272320; --overlay: #353029; --border: #4a433b;
        --text: #e4ded4; --muted: #a59d91; --accent: #6b9e50; --accent-hover: #7db060;
        --error: #d0654e; --success: #7da668; --warning: #d4a04a;
        --mono: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--surface); color: var(--text); font: 14px/1.6 var(--mono); }
      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--accent-hover); text-decoration: underline; }
      nav { display: flex; gap: 1.25rem; align-items: center; padding: .75rem 1.5rem; border-bottom: 1px solid var(--border); background: var(--raised); }
      nav .brand { color: var(--text); font-weight: 700; }
      nav .brand span { color: var(--accent); }
      main { max-width: 46rem; margin: 0 auto; padding: 1.5rem; }
      h1 { font-size: 1.4rem; margin: 0 0 1rem; }
      h2 { font-size: 1.05rem; margin: 1.5rem 0 .5rem; color: var(--muted); }
      .card { background: var(--raised); border: 1px solid var(--border); border-radius: 6px; padding: 1rem 1.25rem; margin: 0 0 .75rem; }
      .card h3 { margin: 0 0 .25rem; font-size: 1rem; }
      .meta { color: var(--muted); font-size: 12px; }
      .badge { font-size: 11px; padding: 0 .4rem; border-radius: 3px; border: 1px solid var(--border); color: var(--muted); }
      .badge.published { border-color: var(--success); color: var(--success); }
      .notice { border-left: 3px solid var(--success); background: var(--raised); padding: .5rem .75rem; margin-bottom: 1rem; }
      .errors { border-left: 3px solid var(--error); background: var(--raised); padding: .5rem .75rem; margin-bottom: 1rem; color: var(--error); }
      .errors h2 { color: var(--error); margin: 0; font-size: .95rem; }
      .field { margin-bottom: .75rem; }
      label { display: block; color: var(--muted); font-size: 12px; margin-bottom: .2rem; }
      input[type=text], textarea { width: 100%; font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: .45rem .6rem; }
      input[type=text]:focus, textarea:focus { outline: none; border-color: #5a8a42; }
      .field_with_errors input, .field_with_errors textarea { border-color: var(--error); }
      input[type=submit], button { font: inherit; cursor: pointer; background: var(--accent); color: #1c1916; border: 0; border-radius: 4px; padding: .4rem .9rem; font-weight: 600; }
      input[type=submit]:hover, button:hover { background: var(--accent-hover); }
      form.button_to { display: inline; }
      form.button_to button { background: transparent; color: var(--error); border: 1px solid var(--error); padding: .2rem .6rem; font-weight: 400; }
      .actions { display: flex; gap: 1rem; align-items: center; margin-top: 1rem; }
      .tabs a.current { color: var(--text); text-decoration: underline; }
      .empty { color: var(--muted); font-style: italic; }
    </style>
  </head>
  <body>
    <nav>
      <%= linkTo("trail·log", rootPath(), { class: "brand" }) %>
      <%= linkTo("All posts", postsPath()) %>
      <%= linkTo("New post", newPostPath()) %>
    </nav>
    <main>
      <% const message = await notice; %>
      <% if (message != null) { %><p class="notice"><%= message %></p><% } %>
      <%= yield %>
    </main>
  </body>
</html>
