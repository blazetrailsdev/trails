{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@blazetrails/trails-tsc/plugins/tse": ["../../packages/trails-tsc/dist/plugins/tse.d.ts"]
    }
  },
  "include": ["src", "templates", "vite.config.ts"]
}
