{
  "name": "@blazetrails/example-browser-sqlite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A trails app that runs in the browser on SQLite (sql.js), with an editor, a preview and the app's console",
  "scripts": {
    "dev": "vite",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/sqlite3": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/trailties": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@noble/ciphers": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "buffer": "^6.0.3",
    "path-browserify": "^1.0.1",
    "sql.js": "^1.13.0",
    "typescript-5": "npm:typescript@5.9.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/path-browserify": "^1.0.3",
    "@types/sql.js": "^1.4.9",
    "playwright": "1.60.0",
    "vite": "^7.0.0"
