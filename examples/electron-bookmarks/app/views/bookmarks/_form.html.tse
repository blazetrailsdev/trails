<%= formWith({ model: bookmark }, (form) => { %>
  <% if (bookmark.errors.isAny()) { %>
    <div class="flash alert"><%= bookmark.errors.fullMessages.join(", ") %></div>
  <% } %>
  <label>Title <%= form.textField("title", { required: true, autofocus: true }) %></label>
  <label>URL <%= form.urlField("url", { required: true, placeholder: "https://" }) %></label>
  <label>Tags <input type="text" name="tag_list" value="<%= tagList %>" placeholder="comma, separated"></label>
  <label>Notes <%= form.textArea("notes", { rows: 4 }) %></label>
  <label>Remind me <%= form.datetimeLocalField("remind_at") %></label>
  <%= form.submit("Save", { class: "button" }) %>
<% }) %>
