<!DOCTYPE html>
<html>
  <head>
    <title><%= contentFor("title") ?? "Reading List" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrfMetaTags() %>
    <link rel="stylesheet" href="/assets/application.css" data-turbo-track="reload">
    <script type="module" src="/assets/application.js" data-turbo-track="reload"></script>
  </head>
  <body>
    <header class="toolbar">
      <%= linkTo("Reading List", rootPath(), { class: "brand" }) %>
      <nav>
        <%= linkTo("New bookmark", newBookmarkPath(), { class: "button" }) %>
        <%= buttonTo("Import…", importPath(), { class: "button secondary" }) %>
        <%= buttonTo("Export…", exportPath(), { class: "button secondary" }) %>
      </nav>
    </header>
    <main class="page">
      <%= render({ partial: "shared/flash" }) %>
      <%= yield %>
    </main>
  </body>
</html>
