{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": ["node", "@blazetrails/activestorage", "@blazetrails/actiontext", "@blazetrails/turbo"]
  },
  "include": ["app", "config"]
}
