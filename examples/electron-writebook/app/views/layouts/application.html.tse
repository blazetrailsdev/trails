<!DOCTYPE html>
<html>
  <head>
    <title><%= contentFor("title") ?? "Bookshelf" %></title>

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta charset="UTF-8">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="turbo-cache-control" content="no-cache">

    <%= csrfMetaTags() %>
    <%= cspMetaTag() %>
    <% if (isSignedIn()) { %>
      <%= hideFromUserStyleTag() %>
    <% } %>

    <%= yield("head") %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/app-icon.png">

    <%= stylesheetLinkTag("_reset", "animation", "arrangement", "base", "books", "breadcrumbs", "buttons", "colors", "dialog", "house", "inputs", "layout", "library", "lightbox", "pages", "panels", "popover", "product", "qr-code", "search", "sidebar", "syntax", "text", "toc", "translations", "utilities", { "data-turbo-track": "reload" }) %>
    <%= await customStylesTag() %>

    <%= javascriptIncludeTag("application", { type: "module", "data-turbo-track": "reload" }) %>
  </head>

  <body data-controller="fullscreen lightbox touch">
    <header id="header">
      <%= yield("header") %>
    </header>

    <div id="toolbar">
      <%= yield("toolbar") %>
    </div>

    <main id="main" class="<%= this.layoutClass %>">
      <%= yield %>
    </main>

    <aside id="sidebar" aria-label="Table of Contents">
      <%= yield("sidebar") %>
    </aside>

    <footer id="footer">
      <%= yield("footer") %>
    </footer>

    <%= await render("layouts/lightbox") %>
  </body>
</html>
