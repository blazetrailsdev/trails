<% contentFor("title", pageTitle(leaf, book)); %>
<% const header = await render("leaves/header", { book, leaf }); %>
<% const sidebar = await render("leaves/sidebar", { book }); %>
<% const navigation = await render("leaves/navigation", { leaf }); %>
<% const page = await leaf.page; const section = await leaf.section; const picture = await leaf.picture; %>
<% if (picture) { await picture.image.load(); if (picture.image.isAttached()) await (await picture.image.attachment)!.blob; } %>
<% let content: unknown = ""; %>
<% if (section) content = await highlightSearchedContent(leaf, simpleFormat(section.body), params.get("search")); %>
<% if (page) content = await highlightSearchedContent(leaf, sanitizeContent((await page.body()).toHtml()), params.get("search")); %>

<%= header %>

<% contentFor("sidebar", () => { %>
  <%= sidebar %>
<% }) %>

<% if (section) { %>
  <div class="page--section <%= section.theme === "dark" ? "theme--dark" : "" %>">
    <h1><%= content %></h1>
  </div>
<% } else if (leaf.isPage()) { %>
  <div class="page--page" data-controller="scroll-to-highlight">
    <%= content %>
  </div>
<% } else if (picture) { %>
  <figure class="page--picture flex flex-column align-center gap margin-none">
    <% if (picture.image.isAttached()) { %>
      <%= linkTo(trailsBlobPath(picture.image), { data: { action: "lightbox#open:prevent", lightboxTarget: "image", lightboxUrlValue: trailsBlobPath(picture.image, { disposition: "attachment", onlyPath: true }) } }, null, () => { %>
        <%= imageTag(picture.largeImage(), { loading: "lazy" }) %>
      <% }) %>
    <% } else { %>
      <%= imageTag("default-picture.webp", { alt: "No image uploaded", loading: "lazy" }) %>
    <% } %>

    <figcaption>
      <%= simpleFormat(picture.caption) %>
    </figcaption>
  </figure>
<% } %>

<% contentFor("footer", () => { %>
  <%= navigation %>
<% }) %>
