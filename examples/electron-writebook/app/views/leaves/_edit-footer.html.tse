<% const nextLink = await linkToNextLeafable(leaf, { hotkey: false, forEdit: true }); %>
<% const deleteForm = await formWith({ url: leafablePath(leaf, { format: "html" }), class: "flex align-center gap-half", method: "delete" }, (form) => { %>
  <%= form.button(null, { class: "btn btn--negative txt-small min-width", data: { turboConfirm: "Are you sure you want to delete this page?" } }, () => { %>
    <%= imageTag("minus.svg", { aria: { hidden: true }, size: 24 }) %>
    <span class="for-screen-reader">Delete <%= leaf.title %></span>
  <% }) %>
<% }); %>
<% contentFor("footer", () => { %>
  <nav class="book__nav flex align-center gap">
    <span class="btn btn--placeholder flex-item-justify-start"></span>

    <%= nextLink %>

    <span class="flex-item-justify-end">
      <%= deleteForm %>
    </span>
  </nav>
<% }) %>
