<% const leafable = await leaf.leafable; %>
<% if (leaf.isPicture()) { await leafable.image.load(); if (leafable.image.isAttached()) await (await leafable.image.attachment).blob; } %>
<% const bodyMarkdown = leaf.isPage() ? await leafable.body() : null; %>
<% const deleteButton = await buttonTo(leafablePath(leaf), { method: "delete", class: "btn btn--negative txt-small" }, null, () => { %>
  <%= imageTag("trash.svg", { aria: { hidden: true }, size: 24 }) %>
  <span class="for-screen-reader">Delete this page</span>
<% }); %>
<%= leafItemTag(leaf, {}, () => { %>
  <span class="btn btn--link arrangement__handle txt-small">
    <%= imageTag("handle.svg", { aria: { hidden: true }, size: 24 }) %>
    <span class="for-screen-reader">Move <%= leaf.title %></span>
  </span>

  <%= linkTo(leafablePath(leaf), { class: "toc__thumbnail", data: { turboFrame: "_top" } }, null, () => { %>
    <%= leaf.isSection() ? leafable.body : "" %>
    <%= leaf.isPage() ? sanitizeContent(bodyMarkdown.toHtml()) : "" %>
    <%= leaf.isPicture() && leafable.image?.isAttached() ? imageTag(leafable.largeImage()) : "" %>
  <% }) %>

  <div class="toc__title flex align-center min-width">
    <%= await formWith({ model: [leaf.association("book").target, leaf], url: leafablePath(leaf), class: "flex align-center max-width min-width", id: domId(leaf, "form") }, (form) => { %>
      <%= form.textField("title", { class: "input full-width", autofocus: true, autocomplete: "off", data: { controller: "autoselect" } }) %>
    <% }) %>

    <span class="flex align-center gap-half">
      <button type="submit" class="btn txt-small btn--positive" form="<%= domId(leaf, "form") %>">
        <%= imageTag("check.svg", { aria: { hidden: true }, size: 24 }) %>
        <span class="for-screen-reader">Save</span>
      </button>

      <%= deleteButton %>
    </span>
  </div>

  <small class="toc__wordcount">
    <% if (leaf.isPage()) { %>
      <%= wordCount(bodyMarkdown.content) %>
    <% } %>
  </small>
<% }) %>
