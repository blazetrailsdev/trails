<%= linkTo(editLeafablePath(leaf, { search: params.get("search") }), { class: "search__result hide_from_reading_mode txt-ink", data: { turboFrame: "_top" } }, null, () => { %>
  <strong><%= sanitizeSearchResult(leaf.readAttribute("title_match")) %>:</strong> <%= sanitizeSearchResult(leaf.readAttribute("content_match")) %>
<% }) %>
<%= linkTo(leafableSlugPath(leaf, { search: params.get("search") }), { class: "search__result hide_from_edit_mode txt-ink", data: { turboFrame: "_top" } }, null, () => { %>
  <strong><%= sanitizeSearchResult(leaf.readAttribute("title_match")) %>:</strong> <%= sanitizeSearchResult(leaf.readAttribute("content_match")) %>
<% }) %>
