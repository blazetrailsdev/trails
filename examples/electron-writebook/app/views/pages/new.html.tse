<% contentFor("title", "New page"); %>
<% const form = await render("pages/form", { book, page: this.page }); %>

<% contentFor("header", () => { %>
  <nav>
    <%= linkTo(book, { class: "btn flex-item-justify-start" }, null, () => { %>
      <%= imageTag("remove.svg", { aria: { hidden: true }, size: 24 }) %>
      <span class="for-screen-reader">Cancel</span>
    <% }) %>

    <button type="submit" form="leafable-editor", class="btn flex-item-justify-end">
      <%= imageTag("check.svg", { aria: { hidden: true }, size: 24 }) %>
      <span class="for-screen-reader">Save</span>
    </button>
  </nav>
<% }) %>

<article class="layout--reading">
  <%= form %>
</article>
