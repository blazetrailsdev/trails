{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2025", "ESNext.Temporal"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "plugins": [
      {
        "name": "@blazetrails/trails-tsc/ts-plugin",
        "viewsDir": "app/views"
      }
    ]
  },
  "include": [
    "app",
    "config",
    "db",
    "test",
    "electron",
    "lib",
    "config.ts",
    "vite.config.ts",
    "Rakefile.ts",
    ".trails/template-registry-augmentation.d.ts",
    ".trails/routes-augmentation.d.ts",
    ".trails/views",
    ".trails/autoload/*/constants.generated.d.ts"
  ]
}
