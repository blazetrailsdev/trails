{
  "name": "@blazetrails/msgpack",
  "version": "0.1.0-alpha0.1",
  "description": "MessagePack serialization, mirroring Ruby's msgpack gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/msgpack"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/msgpack#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@msgpack/msgpack": "^3.1.3"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "msgpack",
      "ref": "v1.8.0",
      "sha": "e4305b4b8a2506422bc78b6fab624907eb7e74a5"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
