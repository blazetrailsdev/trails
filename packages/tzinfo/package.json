{
  "name": "@blazetrails/tzinfo",
  "version": "0.1.0-alpha0.2",
  "description": "Time zone lookups for Trails, standing in for the tzinfo gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/tzinfo"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/tzinfo#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/tzinfo-data/load-path.d.ts",
      "default": "./dist/tzinfo-data/load-path.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "pnpm build:data && tsc",
    "build:data": "(test -d ../../vendor/tzinfo-data/v1.2026.5/.git || pnpm -w vendor:fetch --source tzinfo-data) && pnpm -w tsx scripts/generate-tzinfo-data.ts vendor/tzinfo-data/v1.2026.5/lib packages/tzinfo/dist/tzinfo-data - js"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "tzinfo",
      "ref": "v2.0.6",
      "sha": "d5893c99bbcd842af86023f02a84fac1659b3031"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
