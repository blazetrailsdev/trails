{
  "name": "@blazetrails/tzinfo",
  "version": "0.1.0",
  "description": "Time zone lookups for Trails, standing in for the tzinfo gem",
  "type": "module",
  "main": "dist/tzinfo.js",
  "types": "dist/tzinfo.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tzinfo.d.ts",
      "default": "./dist/tzinfo.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
