    "mysql2": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "mysql2",
      "ref": "0.5.6",
      "sha": "43ea8af635f5e23f054294ef7759320d47f30e5f"
    }
  ],
  "devDependencies": {
    "@types/node": "25.3.5",
    "mysql2": "^3.18.2",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
