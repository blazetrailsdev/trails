{
  "name": "@blazetrails/mysql2",
  "version": "0.1.0-alpha0.3",
  "description": "The MySQL client, mirroring Ruby's mysql2 gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/mysql2"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/mysql2#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
