{
  "name": "@blazetrails/rackup",
  "version": "0.1.0-alpha0",
  "description": "A general server command for Rack applications, mirroring Ruby's rackup",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/rackup"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/rackup#readme",
  "type": "module",
  "bin": {
    "rackup": "./bin/rackup.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
