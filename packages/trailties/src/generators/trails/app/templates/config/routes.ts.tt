  // this.get("manifest", { to: "trails/pwa#manifest", as: "pwa_manifest" });
  // this.get("service-worker", { to: "trails/pwa#service_worker", as: "pwa_service_worker" });

  <%- } -%>
  // Defines the root path route ("/")
  // this.root("posts#index");
});
