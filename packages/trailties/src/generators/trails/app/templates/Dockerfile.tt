# syntax=docker/dockerfile:1

ARG NODE_VERSION=24.16.0
FROM node:${NODE_VERSION}-slim AS base

LABEL fly_launch_runtime="Trails"

WORKDIR /app

ENV TRAILS_ENV="production" \
    NODE_ENV="production"

FROM base AS build

RUN apt-get update -qq && apt-get install --no-install-recommends -y build-essential node-gyp pkg-config python-is-python3

COPY package.json <%= this.packageManager === "pnpm" ? "pnpm-lock.yaml" : "package-lock.json" %>* ./
RUN <%= this.packageManager === "pnpm" ? "corepack enable pnpm && pnpm install" : `${this.packageManager} install` %>

COPY . .
RUN <%= this.packageManager %> run build

FROM base

COPY --from=build /app /app

ENTRYPOINT ["/app/bin/docker-entrypoint"]

EXPOSE 3000
# Start the server through config.ts, so production never loads the trails command dispatcher
CMD ["npx", "rackup", "config.ts"]
