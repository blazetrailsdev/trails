import { Dir } from "@blazetrails/ruby-compat";
import { TestCase } from "@blazetrails/trailties/generators/test-case";
import { <%= this.className().split("::").pop() %>Generator } from "<%= "../".repeat(this.classPath().length + 3) %>lib/<%= this.generatorPath() %><%= this.ext() %>";

export class <%= this.className().split("::").pop() %>GeneratorTest extends TestCase {
  static {
    this.tests(<%= this.className().split("::").pop() %>Generator);
    this.destination(Dir.mktmpdir());
  }

  // test("generator runs without errors", async () => {
  //   await this.runGenerator(["arguments"]);
  // });
}
