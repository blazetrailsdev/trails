import { describe, it, expect } from "vitest";
import "./<%= "../".repeat(this.namespacedName().split("/").length - 1) %>test_helper.js";
import { <%= this.camelizedModules().split("::")[0] %> } from "../<%= "../".repeat(this.namespacedName().split("/").length - 1) %>lib/<%= this.namespacedName() %>/version.js";

describe("<%= this.camelizedModules() %>", () => {
  it("it has a version number", () => {
    expect(<%= this.camelizedModules().replaceAll("::", ".") %>.VERSION).toBeTruthy();
  });
});
