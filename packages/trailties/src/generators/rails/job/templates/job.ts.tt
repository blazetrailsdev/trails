import { <%= ActiveSupport.Inflector.classify(this.parentClassName()) %> } from "<%= "../".repeat(this.classPathParts.length) || "./" %><%= ActiveSupport.Inflector.dasherize(ActiveSupport.Inflector.underscore(this.parentClassName())) %><%= this.ext() %>";

export class <%= this.className().split("::").pop() %>Job extends <%= ActiveSupport.Inflector.classify(this.parentClassName()) %> {
  static {
    this.queueAs("<%= this.options.queue %>");
  }

  perform(...args: unknown[]): void {
    // Do something later
  }
}
