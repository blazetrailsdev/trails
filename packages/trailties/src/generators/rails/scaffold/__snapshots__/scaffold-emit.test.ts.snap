// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ScaffoldGenerator emit > matches snapshot for the controller and validates as TS without Ruby 1`] = `
"import { Post } from "../models/post.js";
import { ApplicationController } from "./application-controller.js";

export class PostsController extends ApplicationController {
  static {
    this.beforeAction("setPost", { only: ["show", "edit", "update", "destroy"] });
  }

  declare posts: Post[];

  declare post: Post;

  async index(): Promise<void> {
    this.posts = await Post.all();
  }

  async show(): Promise<void> {}

  async new(): Promise<void> {
    this.post = Post.new();
  }

  async edit(): Promise<void> {}

  async create(): Promise<void> {
    this.post = Post.new(this.postParams());

    if (await this.post.save()) {
      this.redirectTo(\`/posts/\${this.post.id}\`, { notice: "Post was successfully created." });
    } else {
      await this.render({ action: "new", status: "unprocessable_entity" });
    }
  }

  async update(): Promise<void> {
    if (await this.post.update(this.postParams())) {
      this.redirectTo(\`/posts/\${this.post.id}\`, { notice: "Post was successfully updated.", status: "see_other" });
    } else {
      await this.render({ action: "edit", status: "unprocessable_entity" });
    }
  }

  async destroy(): Promise<void> {
    await this.post.destroyBang();
    this.redirectTo("/posts", { notice: "Post was successfully destroyed.", status: "see_other" });
  }

  protected async setPost(): Promise<void> {
    this.post = await Post.find(this.params.expect("id"));
  }

  protected postParams(): unknown {
    return this.params.expect({ post: ["title", "views"] });
  }
}
"
`;
