<!DOCTYPE html>
<html><head>
<title><%= this.pageTitle %></title>
<meta name="viewport" content="width=device-width" />
<style type="text/css">
  html, body, iframe {
    height: 100%;
  }

  body {
    margin: 0;
  }

  header {
    width: 100%;
    padding: 10px 0 0 0;
    margin: 0;
    background: white;
    font: 12px "Lucida Grande", sans-serif;
    border-bottom: 1px solid #dedede;
    overflow: hidden;
  }

  dl {
    margin: 0 0 10px 0;
    padding: 0;
  }

  dt {
    width: 80px;
    padding: 1px;
    float: left;
    clear: left;
    text-align: right;
    color: #7f7f7f;
  }

  dd {
    margin-left: 90px; /* 80px + 10px */
    padding: 1px;
  }

  dd:empty:before {
    content: "\00a0"; // &nbsp;
  }

  th {
    font-weight: inherit;
    color: #7f7f7f;
    text-align: right;
    white-space: nowrap;
  }

  iframe {
    border: 0;
    width: 100%;
  }
</style>
</head>

<body>
<header>
    <% if (!RubyCompat.rbEqual(RubyCompat.rbFArray(this.email.from()), RubyCompat.rbFArray(this.email.smtpEnvelopeFrom()))) { %>
      <dt>SMTP-From:</dt>
      <dd id="smtp_from"><%= this.email.smtpEnvelopeFrom() %></dd>
    <% } %>

    <% if (!RubyCompat.rbEqual(new Set([...RubyCompat.rbFArray(this.email.to()), ...RubyCompat.rbFArray(this.email.cc()), ...RubyCompat.rbFArray(this.email.bcc())]), new Set(RubyCompat.rbFArray(this.email.smtpEnvelopeTo())))) { %>
      <dt>SMTP-To:</dt>
      <dd id="smtp_to"><%= this.email.smtpEnvelopeTo().join(", ") %></dd>
    <% } %>

    <dt>From:</dt>
    <dd id="from"><%= this.email.header().get("from") %></dd>

    <% if (this.email.replyTo() != null) { %>
      <dt>Reply-To:</dt>
      <dd id="reply_to"><%= this.email.header().get("reply-to") %></dd>
    <% } %>

    <dt>To:</dt>
    <dd id="to"><%= this.email.header().get("to") %></dd>

    <% if (this.email.cc() != null) { %>
      <dt>CC:</dt>
      <dd id="cc"><%= this.email.header().get("cc") %></dd>
    <% } %>

    <% if (this.email.bcc() != null) { %>
      <dt>BCC:</dt>
      <dd id="bcc"><%= this.email.header().get("bcc") %></dd>
    <% } %>

    <dt>Date:</dt>
    <dd id="date"><%= this.email.header().get("date") ?? Time.current().rfc2822() %></dd>

    <dt>Subject:</dt>
    <dd><strong id="subject"><%= this.email.subject() %></strong></dd>

    <% if (Object.keys(this.attachments).length > 0 || Object.keys(this.inlineAttachments).length > 0) { %>
      <dt>Attachments:</dt>
      <dd>
        <% for (const [filename, attachment] of Object.entries(this.attachments)) { %>
          <%= linkTo(filename, attachmentUrl(attachment), { download: filename }) %>
        <% } %>

        <% if (Object.keys(this.inlineAttachments).length > 0) { %>
          (Inline: <% for (const [filename, attachment] of Object.entries(this.inlineAttachments)) { %>
            <%= linkTo(filename, attachmentUrl(attachment), { download: filename }) %><% } %>)
        <% } %>
      </dd>
    <% } %>

    <dt>Format:</dt>
    <% if (this.email.htmlPart() && this.email.textPart()) { %>
      <dd>
        <select id="part" onchange="refreshBody(false);">
          <option <%= this.request.format().equals(Mime.get("html")) ? 'selected' : '' %> value="<%= partQuery('text/html') %>">View as HTML email</option>
          <option <%= this.request.format().equals(Mime.get("text")) ? 'selected' : '' %> value="<%= partQuery('text/plain') %>">View as plain-text email</option>
        </select>
      </dd>
    <% } else if (this.part) { %>
      <dd id="mime_type" data-mime-type="<%= partQuery(this.part.mimeType()) %>"><%= this.part.mimeType() === 'text/html' ? 'HTML email' : 'plain-text email' %></dd>
    <% } else { %>
      <dd id="mime_type" data-mime-type=""></dd>
    <% } %>

    <% if (I18n.availableLocales().length > 1) { %>
      <dt>Locale:</dt>
      <dd>
        <select id="locale" onchange="refreshBody(true);">
          <% for (const locale of I18n.availableLocales()) { %>
            <option <%= I18n.locale() === locale ? 'selected' : '' %> value="<%= localeQuery(locale) %>"><%= locale %></option>
          <% } %>
        </select>
      </dd>
    <% } %>

    <% if (!(this.email.headerFields() == null || this.email.headerFields().length === 0)) { %>
      <dt>Headers:</dt>
      <dd>
        <details>
          <summary>Show all headers</summary>
          <table>
          <% for (const field of this.email.headerFields()) { %>
            <tr>
              <th><%= field.name %>:</th>
              <td><%= field.value %></td>
            </tr>
          <% } %>
          </table>
        </details>
      </dd>
    <% } %>

    <dt>EML File:</dt>
    <dd><%= linkTo("Download", { action: "download" }) %></dd>
  </dl>
</header>

<% if (this.part && this.part.mimeType()) { %>
  <iframe name="messageBody" src="?<%= partQuery(this.part.mimeType()) %>"></iframe>
<% } else { %>
  <p>
    You are trying to preview an email that does not have any content.
    This is probably because the <em>mail</em> method has not been called in <em><%= this._preview.previewName() %>#<%= this.emailAction %></em>.
  </p>
<% } %>

<script>
  function refreshBody(reload) {
    var part_select = document.querySelector('select#part');
    var locale_select = document.querySelector('select#locale');
    var iframe = document.getElementsByName('messageBody')[0];
    var part_param = part_select ?
      part_select.options[part_select.selectedIndex].value :
      document.querySelector('#mime_type').dataset.mimeType;
    var locale_param = locale_select ? locale_select.options[locale_select.selectedIndex].value : null;
    var fresh_location;
    if (locale_param) {
      fresh_location = '?' + part_param + '&' + locale_param;
    } else {
      fresh_location = '?' + part_param;
    }
    iframe.contentWindow.location = fresh_location;

    var url = location.pathname.replace(/\.(txt|html)$/, '');
    var format = /html/.test(part_param) ? '.html' : '.txt';
    var state_to_replace = locale_param ? (url + format + '?' + locale_param) : (url + format);

    if (reload) {
      location.href = state_to_replace;
    } else if (history.replaceState) {
      window.history.replaceState({}, '', state_to_replace);
    }
  }
</script>

</body>
</html>
