# syntax=docker/dockerfile:1

ARG NODE_VERSION=24.16.0
FROM node:${NODE_VERSION}-slim AS base

WORKDIR /app

# Install base packages
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y curl libvips sqlite3

ENV TRAILS_ENV="production" \
    NODE_ENV="production"

FROM base AS build

# Install packages needed to build native modules
RUN apt-get install --no-install-recommends -y build-essential git pkg-config

COPY . .
RUN npm install && npm run build

FROM base

COPY --from=build /app /app

ENTRYPOINT ["/app/bin/docker-entrypoint"]

EXPOSE 3000
CMD ["npx", "rackup", "config.ts"]
