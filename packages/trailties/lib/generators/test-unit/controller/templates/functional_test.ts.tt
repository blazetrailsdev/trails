import { describe, it } from "vitest";
import { IntegrationTest } from "@blazetrails/actionpack";
import { <%= this.isMountableEngine() ? "constGet, include, " : "" %>constSet, TopLevel } from "@blazetrails/ruby-compat";
import "<%= "../".repeat(this.classPathParts.length + 1) %>test-helper.js";

<% this.moduleNamespacing(() => { -%>
export class <%= this.className().split("::").pop() %>ControllerTest extends IntegrationTest {
  static {
    constSet(TopLevel, "<%= this.className().split("::").pop() %>ControllerTest", this);
<% if (this.isMountableEngine()) { -%>
    include(this, (constGet(Object, "<%= this.namespace().name %>::Engine") as { routes(): { urlHelpers(): object } }).routes().urlHelpers());
<% } -%>
  }
}
<% }) -%>

describe("<%= this.className() %>ControllerTest", () => {
<% if (this.actions.length === 0 || this.options.skipRoutes) { -%>
  // it("the truth", () => {
  //   expect(true).toBe(true);
  // });
<% } else { -%>
<% for (const action of this.actions) { -%>
  it("should get <%= action %>", async ({ testCase: t }) => {
    await t.get(t.<%= ActiveSupport.Inflector.camelize(`${this.urlHelperPrefix()}_${action}_url`, "lower") %>());
    t.assertResponse(":success");
  });
<%= action === this.actions.at(-1) ? "" : "\n" -%>
<% } -%>
<% } -%>
});
