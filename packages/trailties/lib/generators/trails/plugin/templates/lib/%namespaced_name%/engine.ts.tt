import { Trails } from "@blazetrails/trailties";

<%= this.wrapInModules(`export class Engine extends Trails.Engine {
${this.isMountable() ? "  static { this.isolateNamespace(" + this.camelizedModules().replaceAll("::", ".") + "); }\n" : ""}${this.isApi() ? "  static { this.config.generators.apiOnly = true; }\n" : ""}}`) %>
