import { NamedBase } from "@blazetrails/trailties/generators";
import { File } from "@blazetrails/ruby-compat/file";

const __dir__ = import.meta.dirname;

export class <%= this.className().split("::").pop() %>Generator extends NamedBase {
  static {
    this.sourceRoot(File.expandPath("templates", __dir__));
  }
}
