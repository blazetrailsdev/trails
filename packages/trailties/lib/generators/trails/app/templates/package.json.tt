<%
  const devDependencies = ["@blazetrails/activerecord-cli", "@blazetrails/trails-tsc"];
  const packages = (development) =>
    JSON.parse(
      `{${this.packageEntries()
        .filter((entry) => !entry.commentedOut && devDependencies.includes(entry.name) === development)
        .join(",")}}`,
    );
-%>
<%= JSON.stringify(
  {
    name: this.originalAppName(),
    version: "0.1.0",
    private: true,
    type: "module",
    exports: {
      "./*.tse": {
        types: "./.trails/views/*.tse.d.ts",
        default: "./.trails/views/*.tse.js",
      },
    },
    scripts: {
      build: "trails-tsc --schema db/schema.ts && cp -R bin dist/",
      test: this.dependsOnSystemTest() ? "vitest run --project unit" : "vitest run",
      trails: "trails",
      dev: "trails server",
      "db:create": "trails db:create",
      "db:migrate": "trails db:migrate",
      "db:seed": "trails db:seed",
      "db:setup": "trails db:setup",
      "db:reset": "trails db:reset",
      prepare: "trails-tsc-views build --views app/views",
    },
    dependencies: packages(false),
    devDependencies: {
      ...packages(true),
      "@types/node": "^22.0.0",
      typescript: "^5.8.0",
      vite: "^7.0.0",
      vitest: "^3.0.0",
      ...(this.skipEslint()
        ? {}
        : {
            "@eslint/js": "^10.0.1",
            eslint: "^10.0.3",
            "eslint-config-prettier": "10.1.8",
            prettier: "3.8.1",
            "typescript-eslint": "^8.57.0",
          }),
    },
    ...(this.options.dev && this.packageManager !== "pnpm"
      ? { overrides: Object.fromEntries(Object.entries(this.trailsDevPackages()).map(([n, p]) => [n, `file:${p}`])) }
      : {}),
  },
  null,
  2,
) %>
