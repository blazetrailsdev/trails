# syntax=docker/dockerfile:1

ARG NODE_VERSION=<%= await this.nodeVersion() %>
FROM node:${NODE_VERSION}-slim AS base

LABEL fly_launch_runtime="Trails"

WORKDIR /app

# Install base packages
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y <%= this.dockerfileBasePackages().join(" ") %> && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV TRAILS_ENV="production" \
    NODE_ENV="production"

FROM base AS build

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y <%= this.dockerfileBuildPackages().join(" ") %> && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

<% if (this.usingNode()) { -%>
# Install JavaScript dependencies
ARG PNPM_VERSION=<%= await this.dockerfilePnpmVersion() %>
<% if (await this.isPnpmThroughCorepack()) { -%>
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@$PNPM_VERSION --activate
<% } else { -%>
RUN npm install -g pnpm@$PNPM_VERSION
<% } -%>

<% } -%>
<% if (this.usingBun()) { -%>
ENV BUN_INSTALL=/usr/local/bun
ENV PATH=/usr/local/bun/bin:$PATH
ARG BUN_VERSION=<%= await this.dockerfileBunVersion() %>
RUN curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"

<% } -%>
# Install application packages
<% if (this.usingBun()) { -%>
COPY package.json bun.lockb ./
RUN bun install --frozen-lockfile
<% } else { -%>
COPY package.json pnpm-lock.yaml ./
RUN <%= this.usingNode() ? "" : "npm install -g pnpm && " %>pnpm install --frozen-lockfile
<% } -%>

# Copy application code
COPY . .
RUN <%= this.usingBun() ? "bun" : "pnpm" %> run build

<% if (!(this.options.api || this.skipAssetPipeline())) { -%>
# Precompiling assets for production without requiring secret TRAILS_MASTER_KEY
RUN SECRET_KEY_BASE_DUMMY=1 ./bin/trails assets:precompile

<% } -%>
# Copy the files tsc does not emit into the compiled tree, then build its entry
RUN tar --exclude=./dist --exclude=./node_modules --exclude="*.ts" -cf - . | tar -xf - -C dist && \
    cd dist && ../node_modules/.bin/trails build

# Keep only production dependencies, so tsx and typescript stay out of the runtime image
RUN <%= this.usingBun() ? "rm -rf node_modules && bun install --frozen-lockfile --production" : "pnpm prune --prod" %>

FROM base

COPY --from=build /app/dist /app
COPY --from=build /app/node_modules /app/node_modules

ENTRYPOINT ["/app/bin/docker-entrypoint"]

EXPOSE 3000
# Start the compiled server through config.js, so production never loads TypeScript or the trails command dispatcher
CMD ["node", "--no-experimental-strip-types", "node_modules/@blazetrails/rackup/bin/rackup.js", "config.js"]
