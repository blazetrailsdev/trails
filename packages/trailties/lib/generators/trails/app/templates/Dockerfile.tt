# syntax=docker/dockerfile:1

ARG NODE_VERSION=26.13.0
FROM node:${NODE_VERSION}-slim AS base

LABEL fly_launch_runtime="Trails"

WORKDIR /app

ENV TRAILS_ENV="production" \
    NODE_ENV="production"

FROM base AS build

RUN apt-get update -qq && apt-get install --no-install-recommends -y build-essential node-gyp pkg-config python-is-python3

<% if (this.usingNode()) { -%>
# Install JavaScript dependencies
ARG PNPM_VERSION=<%= await this.dockerfilePnpmVersion() %>
<% if (await this.isPnpmThroughCorepack()) { -%>
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@$PNPM_VERSION --activate
<% } else { -%>
RUN npm install -g pnpm@$PNPM_VERSION
<% } -%>

<% } -%>
<% if (this.usingBun()) { -%>
ENV BUN_INSTALL=/usr/local/bun
ENV PATH=/usr/local/bun/bin:$PATH
ARG BUN_VERSION=<%= await this.dockerfileBunVersion() %>
RUN curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"

<% } -%>
# Install application packages
<% if (this.usingBun()) { -%>
COPY package.json bun.lockb ./
RUN bun install --frozen-lockfile
<% } else { -%>
COPY package.json pnpm-lock.yaml ./
RUN <%= this.usingNode() ? "" : "npm install -g pnpm && " %>pnpm install --frozen-lockfile
<% } -%>

# Copy application code
COPY . .
RUN <%= this.usingBun() ? "bun" : "pnpm" %> run build

FROM base

COPY --from=build /app /app

ENTRYPOINT ["/app/bin/docker-entrypoint"]

EXPOSE 3000
# Start the server through config.ts, so production never loads the trails command dispatcher
CMD ["npx", "rackup", "config.ts"]
