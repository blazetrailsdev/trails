<p style="color: green"><%%= notice %></p>

<%%= render(this.<%= ActiveSupport.Inflector.camelize(this.singularTableName(), false) %>) %>

<div>
  <%%= linkTo("Edit this <%= this.humanName().toLowerCase() %>", <%= this.editHelper(undefined, { type: "path" }) %>) %> |
  <%%= linkTo("Back to <%= ActiveSupport.Inflector.pluralize(this.humanName()).toLowerCase() %>", <%= this.indexHelper({ type: "path" }) %>()) %>

  <%%= buttonTo("Destroy this <%= this.humanName().toLowerCase() %>", <%= this.modelResourceName(ActiveSupport.Inflector.camelize(this.singularTableName(), false), { prefix: "this." }) %>, { method: "delete" }) %>
</div>
