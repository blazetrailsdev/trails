{
  "name": "@blazetrails/trailties",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "trails": "./bin/trails.js",
    "trails-server": "./bin/trails-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./all": "./dist/all.js",
    "./rails": {
      "types": "./dist/rails.d.ts",
      "default": "./dist/rails.js"
    },
    "./trailties/*": {
      "types": "./dist/trailties/*.d.ts",
      "default": "./dist/trailties/*.js"
    },
    "./test-unit/trailtie": {
      "types": "./dist/test-unit/trailtie.d.ts",
      "default": "./dist/test-unit/trailtie.js"
    },
    "./app-path": {
      "types": "./dist/app-path.d.ts",
      "default": "./dist/app-path.js"
    },
    "./commands": {
      "types": "./dist/bin.d.ts",
      "default": "./dist/bin.js"
    },
    "./generators": "./dist/generators/index.js",
    "./autoloaders/inflector": {
      "types": "./dist/autoloaders/inflector.d.ts",
      "default": "./dist/autoloaders/inflector.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./trailtie": {
      "types": "./dist/trailtie.d.ts",
      "default": "./dist/trailtie.js"
    },
    "./trailtie/configuration": {
      "types": "./dist/trailtie/configuration.d.ts",
      "default": "./dist/trailtie/configuration.js"
    },
    "./test-help": {
      "types": "./dist/test-help.d.ts",
      "default": "./dist/test-help.js"
    },
    "./testing/maintain-test-schema": {
      "types": "./dist/testing/maintain-test-schema.d.ts",
      "default": "./dist/testing/maintain-test-schema.js"
    },
    "./vite": {
      "types": "./dist/server/vite-plugin.d.ts",
      "default": "./dist/server/vite-plugin.js"
    },
    "./template-builder": {
      "types": "./dist/template-builder/index.d.ts",
      "default": "./dist/template-builder/index.js"
    },
    "./template-builder/testing": {
      "types": "./dist/template-builder/testing.d.ts",
      "default": "./dist/template-builder/testing.js"
    }
  },
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "node -e \"require('fs').cpSync('src/generators', 'dist/generators', { recursive: true, filter: (source) => !/\\.(ts|snap)$/.test(source) }); for (const name of ['credentials', 'encrypted', 'test']) require('fs').cpSync(`src/commands/${name}/USAGE`, `dist/commands/${name}/USAGE`); require('fs').cpSync('src/templates/rails', 'dist/templates/rails', { recursive: true })\" && trails-tsc-views build --views dist/templates/rails --in-place && trails-tsc-views build-templates dist/generators dist/commands/credentials/USAGE dist/commands/encrypted/USAGE dist/commands/test/USAGE"
  },
  "files": [
    "dist",
    "bin"
  ],
  "dependencies": {
    "@blazetrails/actioncable": "workspace:*",
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/html-sanitizer": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/thor": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/tse-compiler": "workspace:*",
    "commander": "^14.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@blazetrails/activerecord-cli": "workspace:*",
    "@blazetrails/activestorage": "workspace:*",
    "@blazetrails/et-orbi": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "typescript": "7.1.0-dev.20260920.1"
  },
  "peerDependencies": {
    "@blazetrails/activestorage": "workspace:*",
    "typescript": "7.1.0-dev.20260920.1"
  },
  "peerDependenciesMeta": {
    "@blazetrails/activestorage": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
