{
  "name": "@blazetrails/zeitwerk",
  "version": "0.1.0",
  "description": "Build-time autoloader for Trails, mirroring Zeitwerk",
  "type": "module",
  "main": "dist/zeitwerk.js",
  "types": "dist/zeitwerk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/zeitwerk.d.ts",
      "default": "./dist/zeitwerk.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "zeitwerk",
      "ref": "v2.7.2",
      "sha": "6aa28216c8dbea60bea097d7c7e6f4cc5210a080"
    }
  ]
}
