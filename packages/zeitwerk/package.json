{
  "name": "@blazetrails/zeitwerk",
  "version": "0.1.0-alpha0.1",
  "description": "Build-time autoloader for Trails, mirroring Zeitwerk",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/zeitwerk"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/zeitwerk#readme",
  "type": "module",
  "main": "dist/zeitwerk.js",
  "types": "dist/zeitwerk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/zeitwerk.d.ts",
      "default": "./dist/zeitwerk.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "zeitwerk",
      "ref": "v2.7.3",
      "sha": "77c971c0f602bd0e5961d22dc7541d863737dbcb"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
