{
  "name": "@blazetrails/actionmailer",
  "version": "0.1.0",
  "description": "Email composition and delivery for Trails, mirroring the actionmailer gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/mail": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  }
}
