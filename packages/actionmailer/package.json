{
  "name": "@blazetrails/actionmailer",
  "version": "0.1.0-alpha0.2",
  "description": "Email composition and delivery for Trails, mirroring the actionmailer gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/actionmailer"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/actionmailer#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/mail": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
