{
  "name": "@blazetrails/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build && pnpm run docs:build",
    "preview": "vite preview",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "docs:typedoc": "tsc --build ../../tsconfig.json && typedoc --tsconfig ../../tsconfig.json && node scripts/escape-typedoc.mjs",
    "docs:dev": "pnpm run docs:typedoc && vitepress dev docs",
    "docs:build": "pnpm run docs:typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
