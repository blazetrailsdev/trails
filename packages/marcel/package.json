{
  "name": "@blazetrails/marcel",
  "version": "0.1.0",
  "description": "MIME type detection for Trails, mirroring the marcel gem",
  "type": "module",
  "main": "dist/marcel.js",
  "types": "dist/marcel.d.ts",
  "exports": {
    ".": {
      "types": "./dist/marcel.d.ts",
      "default": "./dist/marcel.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "marcel",
      "ref": "v1.0.4",
      "sha": "cdf0e659c87f81e5d2b393cff3569f870bd71c47"
    }
  ]
}
