{
  "name": "@blazetrails/marcel",
  "version": "0.1.0-alpha0.1",
  "description": "MIME type detection for Trails, mirroring the marcel gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/marcel"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/marcel#readme",
  "type": "module",
  "main": "dist/marcel.js",
  "types": "dist/marcel.d.ts",
  "exports": {
    ".": {
      "types": "./dist/marcel.d.ts",
      "default": "./dist/marcel.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "marcel",
      "ref": "v1.0.4",
      "sha": "cdf0e659c87f81e5d2b393cff3569f870bd71c47"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
