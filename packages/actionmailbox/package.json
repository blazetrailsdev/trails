{
  "name": "@blazetrails/actionmailbox",
  "version": "0.1.0",
  "description": "Inbound email routing for Trails, mirroring the actionmailbox gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "rm -rf dist/app dist/.trails && mkdir -p dist/app && cp -R app/views dist/app/ && trails-tsc-views build --views dist/app/views --in-place && node -e \"require('fs').cpSync('src/trails/generators', 'dist/trails/generators', { recursive: true, filter: (source) => !/\\\\.ts$/.test(source) })\" && trails-tsc-views build-templates dist/trails/generators"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activestorage": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/mail": "workspace:*",
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/actionmailer": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.2",
      "sha": "3235827585d87661942c91bc81f64f56d710f0b2"
    }
  ]
}
