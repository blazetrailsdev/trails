<% provide("title", "Deliver new inbound email") %>

<h1>Deliver new inbound email</h1>

<%= formWith({ url: mainApp.trailsConductorInboundEmailsPath(), scope: "mail", local: true }, (form) => { %>
  <div>
    <%= form.label("from", "From") %><br>
    <%= form.textField("from", { value: params().get("from") }) %>
  </div>

  <div>
    <%= form.label("to", "To") %><br>
    <%= form.textField("to", { value: params().get("to") }) %>
  </div>

  <div>
    <%= form.label("cc", "CC") %><br>
    <%= form.textField("cc", { value: params().get("cc") }) %>
  </div>

  <div>
    <%= form.label("bcc", "BCC") %><br>
    <%= form.textField("bcc", { value: params().get("bcc") }) %>
  </div>

  <div>
    <%= form.label("x_original_to", "X-Original-To") %><br>
    <%= form.textField("x_original_to", { value: params().get("x_original_to") }) %>
  </div>

  <div>
    <%= form.label("in_reply_to", "In-Reply-To") %><br>
    <%= form.textField("in_reply_to", { value: params().get("in_reply_to") }) %>
  </div>

  <div>
    <%= form.label("subject", "Subject") %><br>
    <%= form.textField("subject", { value: params().get("subject") }) %>
  </div>

  <div>
    <%= form.label("body", "Body") %><br>
    <%= form.textarea("body", { size: "40x20", value: params().get("body") }) %>
  </div>

  <div>
    <%= form.label("attachments", "Attachments") %><br>
    <%= form.fileField("attachments", { multiple: true }) %>
  </div>

  <%= form.submit("Deliver inbound email") %>
<% }) %>
