{
  "name": "@blazetrails/raabro",
  "version": "0.1.0",
  "description": "Parser combinators for Trails, mirroring the raabro gem",
  "type": "module",
  "main": "dist/raabro.js",
  "types": "dist/raabro.d.ts",
  "exports": {
    ".": {
      "types": "./dist/raabro.d.ts",
      "default": "./dist/raabro.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "raabro",
      "ref": "v1.4.0",
      "sha": "aaf1aa27e7bfb86a63339f4ebf3938ff2e0c0258"
    }
  ]
}
