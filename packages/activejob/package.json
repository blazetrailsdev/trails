{
  "name": "@blazetrails/activejob",
  "version": "0.1.0",
  "description": "Job framework with pluggable queue adapters for Trails, mirroring the activejob gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ]
}
