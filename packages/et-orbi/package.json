{
  "name": "@blazetrails/et-orbi",
  "version": "0.1.0-alpha0.2",
  "description": "Zoned times for Trails, mirroring the et-orbi gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/et-orbi"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/et-orbi#readme",
  "type": "module",
  "main": "dist/et-orbi.js",
  "types": "dist/et-orbi.d.ts",
  "exports": {
    ".": {
      "types": "./dist/et-orbi.d.ts",
      "default": "./dist/et-orbi.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/tzinfo": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/chronic": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "@types/node": "25.3.5"
  },
  "mirrors": [
    {
      "source": "et-orbi",
      "ref": "v1.2.11",
      "sha": "037e2074b009186d2da43e0e948069d874abe10c"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
