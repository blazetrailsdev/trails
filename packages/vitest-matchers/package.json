{
  "name": "@blazetrails/vitest-matchers",
  "version": "0.1.0-alpha0.2",
  "description": "Vitest matchers for the Minitest assertions whose meaning turns on Ruby semantics",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/vitest-matchers"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/vitest-matchers#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  }
}
