{
  "name": "@blazetrails/image-processing",
  "version": "0.1.0",
  "description": "Image processing pipelines for Trails, mirroring the image_processing gem",
  "type": "module",
  "main": "dist/image-processing.js",
  "types": "dist/image-processing.d.ts",
  "exports": {
    ".": {
      "types": "./dist/image-processing.d.ts",
      "default": "./dist/image-processing.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/mini-magick": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*",
    "wasm-vips": "0.0.19"
  },
  "peerDependencies": {
    "wasm-vips": "0.0.19"
  },
  "peerDependenciesMeta": {
    "wasm-vips": {
      "optional": true
    }
  },
  "mirrors": [
    {
      "source": "image_processing",
      "ref": "v1.14.0",
      "sha": "8185ea61518d8cf477594505cd4b5ab478b28aea"
    }
  ]
}
