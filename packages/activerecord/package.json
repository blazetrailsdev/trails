{
  "name": "@blazetrails/activerecord",
  "version": "0.1.0",
  "description": "ORM layer mirroring Ruby's ActiveRecord, built on @blazetrails/arel and @blazetrails/activemodel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures.js": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./connection-adapters/sqlite3-adapter.js": {
      "types": "./dist/connection-adapters/sqlite3-adapter.d.ts",
      "default": "./dist/connection-adapters/sqlite3-adapter.js"
    },
    "./connection-adapters/better-sqlite3-adapter.js": {
      "types": "./dist/connection-adapters/better-sqlite3-adapter.d.ts",
      "default": "./dist/connection-adapters/better-sqlite3-adapter.js"
    },
    "./connection-adapters/node-sqlite-adapter.js": {
      "types": "./dist/connection-adapters/node-sqlite-adapter.d.ts",
      "default": "./dist/connection-adapters/node-sqlite-adapter.js"
    },
    "./connection-adapters/expo-sqlite-adapter.js": {
      "types": "./dist/connection-adapters/expo-sqlite-adapter.d.ts",
      "default": "./dist/connection-adapters/expo-sqlite-adapter.js"
    },
    "./connection-adapters/libsql-adapter.js": {
      "types": "./dist/connection-adapters/libsql-adapter.d.ts",
      "default": "./dist/connection-adapters/libsql-adapter.js"
    },
    "./connection-adapters/postgresql-adapter.js": {
      "types": "./dist/connection-adapters/postgresql-adapter.d.ts",
      "default": "./dist/connection-adapters/postgresql-adapter.js"
    },
    "./connection-adapters/mysql2-adapter.js": {
      "types": "./dist/connection-adapters/mysql2-adapter.d.ts",
      "default": "./dist/connection-adapters/mysql2-adapter.js"
    },
    "./encryption": {
      "types": "./dist/encryption/index.d.ts",
      "default": "./dist/encryption/index.js"
    },
    "./encryption/*": {
      "types": "./dist/encryption/*.d.ts",
      "default": "./dist/encryption/*.js"
    },
    "./support/*": null,
    "./cases/*": null,
    "./constants.query-assertions.generated": null,
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/arel": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/i18n": "workspace:*"
  },
  "peerDependencies": {
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/msgpack": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "expo-sqlite": "^15.0.0",
    "libsql": "^0.5.29",
    "mysql2": "^3.18.2",
    "pg": "^8.19.0"
  },
  "peerDependenciesMeta": {
    "@blazetrails/activejob": {
      "optional": true
    },
    "@blazetrails/msgpack": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "libsql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/msgpack": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "typescript": "7.1.0-dev.20260920.1"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "mysql2",
      "ref": "0.5.6",
      "sha": "43ea8af635f5e23f054294ef7759320d47f30e5f"
    },
    {
      "source": "pg",
      "ref": "v1.5.9",
      "sha": "afe2f208f7d5eacea1260ce1def10e1fb30b8241"
    },
    {
      "source": "rails",
      "ref": "v8.0.2",
      "sha": "3235827585d87661942c91bc81f64f56d710f0b2"
    },
    {
      "source": "sqlite3",
      "ref": "v2.6.0",
      "sha": "2724f7bd84db6b4f403b15e8a49cba39fa99b59a"
    }
  ]
}
