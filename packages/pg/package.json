{
  "name": "@blazetrails/pg",
  "version": "0.1.0-alpha0",
  "description": "The PostgreSQL client, mirroring Ruby's pg gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/pg"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/pg#readme",
  "type": "module",
  "main": "dist/index.js",
