{
  "name": "@blazetrails/actionview",
  "version": "0.1.0",
  "description": "ActionView — mirroring Rails ActionView",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tse-modules": {
      "types": "./types/tse-modules.d.ts",
      "default": "./types/tse-modules.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist",
    "types"
  ],
  "license": "MIT",
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/html-sanitizer": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/tse-compiler": "workspace:*",
    "@blazetrails/builder": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "typescript": "7.1.0-dev.20260920.1"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.2",
      "sha": "3235827585d87661942c91bc81f64f56d710f0b2"
    },
    {
      "source": "rails-dom-testing",
      "ref": "v2.2.0",
      "sha": "a14001a41d514ece1a7c4d03a1d9bc69edf677d1"
    }
  ]
}
