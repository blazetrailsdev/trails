{
  "name": "@blazetrails/actionview",
  "version": "0.1.0",
  "description": "ActionView — mirroring Rails ActionView",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tse-modules": {
      "types": "./types/tse-modules.d.ts",
      "default": "./types/tse-modules.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist",
    "types"
  ],
  "license": "MIT",
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/html-sanitizer": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/tse-compiler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.1.0-dev.20260920.1"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@blazetrails/actionpack": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@blazetrails/actionpack": {
      "optional": true
    }
  }
}
