<p id="notice"><%= notice %></p>

<h1>Messages</h1>

<table>
  <thead>
    <tr>
      <th>Subject</th>
      <th>Content</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% for (const message of await this.messages) { %>
      <tr>
        <td><%= message.subject %></td>
        <% await message.richTextContent %><td><%= await message.content.toString() %></td>
        <td><%= linkTo('Show', message) %></td>
        <td><%= linkTo('Edit', editMessagePath(message)) %></td>
        <td><%= linkTo('Destroy', message, { method: "delete", data: { confirm: 'Are you sure?' } }) %></td>
      </tr>
    <% } %>
  </tbody>
</table>

<br>

<%= linkTo('New Message', newMessagePath()) %>
