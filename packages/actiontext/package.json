{
  "name": "@blazetrails/actiontext",
  "version": "0.1.0",
  "description": "Rich text content and editing for Trails, mirroring the actiontext gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "app"
  ],
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "rm -rf dist/app dist/.trails && mkdir -p dist/app && cp -R app/views dist/app/ && trails-tsc-views build --views dist/app/views --in-place && cp -R lib/generators/action-text/install/templates dist/generators/action-text/install/ && cp -R lib/trails/generators/test-unit/install/templates dist/trails/generators/test-unit/install/ && trails-tsc-views build-templates dist/generators dist/trails/generators"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activestorage": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/html-sanitizer": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/thor": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/trails-tsc": "workspace:*"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.2",
      "sha": "3235827585d87661942c91bc81f64f56d710f0b2"
    }
  ]
}
