{
  "name": "@blazetrails/actiontext",
  "version": "0.1.0-alpha0.3",
  "description": "Rich text content and editing for Trails, mirroring the actiontext gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/actiontext"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/actiontext#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "app",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "rm -rf dist/app/views dist/.trails && mkdir -p dist/app && cp -R app/views dist/app/ && trails-tsc-views build --views dist/app/views --in-place && cp -R lib/generators/action-text/install/templates dist/generators/action-text/install/ && cp -R lib/trails/generators/test-unit/install/templates dist/trails/generators/test-unit/install/ && trails-tsc-views build-templates dist/generators dist/trails/generators"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activestorage": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/html-sanitizer": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/thor": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/actionmailer": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@rails/actiontext": "8.0.200",
    "playwright": "^1.60.0",
    "trix": "2.1.19",
    "vite": "^7.0.0"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
