{
  "name": "@blazetrails/activesupport",
  "version": "0.1.0",
  "description": "Core utilities and inflection, mirroring Ruby's ActiveSupport",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./message-verifier": {
      "types": "./dist/message-verifier.d.ts",
      "default": "./dist/message-verifier.js"
    },
    "./message-verifiers": {
      "types": "./dist/message-verifiers.d.ts",
      "default": "./dist/message-verifiers.js"
    },
    "./message-encryptor": {
      "types": "./dist/message-encryptor.d.ts",
      "default": "./dist/message-encryptor.js"
    },
    "./key-generator": {
      "types": "./dist/key-generator.d.ts",
      "default": "./dist/key-generator.js"
    },
    "./digest": {
      "types": "./dist/digest.d.ts",
      "default": "./dist/digest.js"
    },
    "./secure-compare-rotator": {
      "types": "./dist/secure-compare-rotator.d.ts",
      "default": "./dist/secure-compare-rotator.js"
    },
    "./security-utils": {
      "types": "./dist/security-utils.d.ts",
      "default": "./dist/security-utils.js"
    },
    "./configuration-file": {
      "types": "./dist/configuration-file.d.ts",
      "default": "./dist/configuration-file.js"
    },
    "./gzip": {
      "types": "./dist/gzip.d.ts",
      "default": "./dist/gzip.js"
    },
    "./message-pack": {
      "types": "./dist/message-pack/index.d.ts",
      "default": "./dist/message-pack/index.js"
    },
    "./glob": {
      "types": "./dist/glob.d.ts",
      "default": "./dist/glob.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "default": "./dist/temporal.js"
    },
    "./testing/temporal-helpers": {
      "types": "./dist/testing/temporal-helpers.d.ts",
      "default": "./dist/testing/temporal-helpers.js"
    },
    "./core-ext/range/conversions": {
      "types": "./dist/core-ext/range/conversions.d.ts",
      "default": "./dist/core-ext/range/conversions.js"
    },
    "./core-ext/range/each": {
      "types": "./dist/core-ext/range/each.d.ts",
      "default": "./dist/core-ext/range/each.js"
    },
    "./cache/file-store": {
      "types": "./dist/cache/file-store.d.ts",
      "default": "./dist/cache/file-store.js"
    },
    "./cache/*": {
      "types": "./dist/cache/*.d.ts",
      "default": "./dist/cache/*.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@blazetrails/nokogiri": "workspace:*"
  },
  "dependencies": {
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "tinyglobby": "^0.2.16"
  },
  "optionalDependencies": {
    "yaml": "^2.8.3"
  },
  "peerDependencies": {
    "@blazetrails/nokogiri": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@blazetrails/nokogiri": {
      "optional": true
    }
  }
}
