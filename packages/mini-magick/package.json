{
  "name": "@blazetrails/mini-magick",
  "version": "0.1.0",
  "description": "ImageMagick command lines for Trails, mirroring the mini_magick gem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/mini-magick"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/mini-magick#readme",
  "type": "module",
  "main": "dist/mini-magick.js",
  "types": "dist/mini-magick.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mini-magick.d.ts",
      "default": "./dist/mini-magick.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "mini_magick",
      "ref": "v5.3.1",
      "sha": "ddcbfe9632667876be10373e1e01252617e74057"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
