{
  "name": "@blazetrails/turbo",
  "version": "0.1.0",
  "description": "Turbo for Trails, mirroring the turbo-rails gem",
  "type": "module",
  "main": "dist/turbo-trails.js",
  "types": "dist/types/turbo-trails.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/turbo-trails.d.ts",
      "default": "./dist/turbo-trails.js"
    },
    "./*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {},
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/actioncable": "workspace:*",
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "mirrors": [
    {
      "source": "turbo-rails",
      "ref": "v2.0.23",
      "sha": "435135b26a4b62e49d2f55bb4b1fd419e3bfb228"
    }
  ]
}
