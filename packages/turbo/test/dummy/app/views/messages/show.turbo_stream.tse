<%= await turboStream.remove(this.message) %>
<%= await turboStream.replace(this.message) %>
<%= await turboStream.replace(this.message, "Something else") %>
<%= await turboStream.replace(this.otherMessage, "Something fifth") %>
<%= await turboStream.replace(this.otherMessage, "Something fifth", { method: "morph" }) %>
<%= await turboStream.update(this.otherMessage, "Something fifth", { method: "morph" }) %>
<%= await turboStream.replace(this.otherMessage, { partial: "messages/message", locals: { message: this.otherMessage } }) %>
<%= await turboStream.append("messages", this.message) %>
<%= await turboStream.append("messages", { partial: "messages/message", locals: { message: this.otherMessage } }) %>
<%= await turboStream.prepend("messages", this.message) %>
<%= await turboStream.prepend("messages", { partial: "messages/message", locals: { message: this.otherMessage } }) %>
