<!DOCTYPE html>
<html>
  <head>
    <title>Dummy</title>
    <%= csrfMetaTags() %>

    <%= stylesheetLinkTag("application", { media: "all" }) %>
    <%= yield("head") %>
    <%= javascriptIncludeTag("/app/javascript/application.js", { type: "module" }) %>
  </head>

  <body class="<%= isTurboNativeApp() ? "turbo-native" : "" %>">
    <%= yield %>
  </body>
</html>
