{
  "name": "@blazetrails/tse-compiler",
  "version": "0.1.0-alpha0",
  "description": "TSE (Trails Server Embedded) compiler — lexer, AST, JS emitter. Rails analogue: the erubi gem.",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/tse-compiler"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/tse-compiler#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "mirrors": [
    {
      "source": "erubi",
      "ref": "1.13.1",
      "sha": "f1a0fb5bfb2a2604c0cf850d3c960bfc458421b6"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
