{
  "name": "@blazetrails/i18n",
  "version": "0.1.0",
  "description": "Port of the Ruby i18n gem: Config, exceptions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "default": "./dist/date.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*"
  },
  "optionalDependencies": {
    "yaml": "^2.8.3"
  }
}
