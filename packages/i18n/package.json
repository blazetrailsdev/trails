{
  "name": "@blazetrails/i18n",
  "version": "0.1.0-alpha0.2",
  "description": "Port of the Ruby i18n gem: Config, exceptions",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/i18n"
