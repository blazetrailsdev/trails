{
  "name": "@blazetrails/ruby-compat",
  "version": "0.1.0",
  "description": "Ruby core/stdlib primitives that trails calls but Rails does not define: a leaf package with no workspace dependencies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./include": {
      "types": "./dist/include.d.ts",
      "default": "./dist/include.js"
    },
    "./method-missing-proxy": {
      "types": "./dist/method-missing-proxy.d.ts",
      "default": "./dist/method-missing-proxy.js"
    },
    "./name-error": {
      "types": "./dist/name-error.d.ts",
      "default": "./dist/name-error.js"
    },
    "./psych": {
      "types": "./dist/psych.d.ts",
      "default": "./dist/psych.js"
    },
    "./psych-adapter": {
      "types": "./dist/psych-adapter.d.ts",
      "default": "./dist/psych-adapter.js"
    },
    "./range": {
      "types": "./dist/range.d.ts",
      "default": "./dist/range.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "optionalDependencies": {
    "yaml": "^2.8.3"
  }
}
