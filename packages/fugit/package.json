{
  "name": "@blazetrails/fugit",
  "version": "0.1.0-alpha0",
  "description": "Cron, duration and time parsing for Trails, mirroring the fugit gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/fugit"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/fugit#readme",
  "type": "module",
  "main": "dist/fugit.js",
  "types": "dist/fugit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fugit.d.ts",
      "default": "./dist/fugit.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*",
    "@blazetrails/et-orbi": "workspace:*",
    "@blazetrails/raabro": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/tzinfo": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/chronic": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "fugit",
      "ref": "v1.11.1",
      "sha": "228b53ded4be3d86412b6dd62c831a7a459d9ef4"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
