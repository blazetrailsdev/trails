{
  "name": "@blazetrails/globalid",
  "version": "0.1.0-alpha0.2",
  "description": "GlobalID support for Trails, mirroring the globalid gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/globalid"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/globalid#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signed-global-id": {
      "types": "./dist/signed-global-id.d.ts",
      "default": "./dist/signed-global-id.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.d.ts.map"
  ],
  "sideEffects": [
    "./dist/constants.generated.js",
    "./dist/global-id.js",
    "./dist/identification.js",
    "./dist/index.js",
    "./dist/locator.js",
    "./dist/signed-global-id.js",
    "./dist/uri/gid.js",
    "./dist/verifier.js"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/activesupport": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/activemodel": "workspace:*",
    "@types/node": "25.3.5"
  },
  "mirrors": [
    {
      "source": "globalid",
      "ref": "v1.3.0",
      "sha": "a10102196ceaa9ffec3744eda857ebe421a57134"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
