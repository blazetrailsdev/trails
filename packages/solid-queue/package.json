{
  "name": "@blazetrails/solid-queue",
  "version": "0.1.0",
  "description": "Database-backed Active Job backend for Trails, mirroring the solid_queue gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "node -e \"for (const g of ['install', 'update']) require('fs').cpSync('lib/generators/solid-queue/' + g + '/templates', 'dist/generators/solid-queue/' + g + '/templates', { recursive: true })\" && trails-tsc-views build-templates dist/generators"
  },
  "dependencies": {
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/arel": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/fugit": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/thor": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/sqlite3": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "solid_queue",
      "ref": "v1.7.2",
      "sha": "b9c646a8486ef3e76f70919568cac070276da0e1"
    }
  ]
}
