#!/usr/bin/env node
import { Dir } from "@blazetrails/ruby-compat";
import "../config/environment.ts";

// A static import here would evaluate before the initializers finish: only this
// file's body waits for the top-level await in config/environment.ts.
for (const file of Dir.glob(`${import.meta.dirname}/../app/jobs/**/*.ts`)) await import(file);

const { Cli } = await import("@blazetrails/solid-queue/cli");
await Cli.start(process.argv.slice(2));
