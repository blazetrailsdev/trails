#!/usr/bin/env node
import { File, rbArgv } from "@blazetrails/ruby-compat";

const ENVIRONMENT = `${import.meta.dirname}/../config/environment`;
await import((await File.isExistAsync(`${ENVIRONMENT}.ts`)) ? `${ENVIRONMENT}.ts` : `${ENVIRONMENT}.js`);

const { Cli } = await import("@blazetrails/solid-queue/cli");
await Cli.start(rbArgv());
