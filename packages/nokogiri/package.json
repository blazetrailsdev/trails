  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "nokogiri",
      "ref": "v1.19.7",
      "sha": "cb8cd033a3c6c67109a745f7eb4a98b05e82adbe"
    }
  ],
  "publishConfig": {
