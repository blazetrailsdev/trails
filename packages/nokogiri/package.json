{
  "name": "@blazetrails/nokogiri",
  "version": "0.1.0-alpha0.1",
  "description": "XML/SAX parsing for Trails, mirroring Nokogiri's XML surface",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/nokogiri"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/nokogiri#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
