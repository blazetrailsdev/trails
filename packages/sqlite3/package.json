{
  "name": "@blazetrails/sqlite3",
  "version": "0.1.0",
  "description": "The SQLite client, mirroring Ruby's sqlite3 gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/sqlite3"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/sqlite3#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.ts",
      "default": "./dist/better-sqlite3.js"
    },
    "./libsql": {
      "types": "./dist/libsql.d.ts",
      "default": "./dist/libsql.js"
    },
    "./node-sqlite": {
      "types": "./dist/node-sqlite.d.ts",
      "default": "./dist/node-sqlite.js"
    },
    "./expo-sqlite": {
      "types": "./dist/expo-sqlite.d.ts",
      "default": "./dist/expo-sqlite.js"
    },
    "./engine/better-sqlite3": {
      "types": "./dist/engine/better-sqlite3.d.ts",
      "default": "./dist/engine/better-sqlite3.js"
    },
    "./engine/libsql": {
      "types": "./dist/engine/libsql.d.ts",
      "default": "./dist/engine/libsql.js"
    },
    "./engine/node-sqlite": {
      "types": "./dist/engine/node-sqlite.d.ts",
      "default": "./dist/engine/node-sqlite.js"
    },
    "./engine/expo-sqlite": {
      "types": "./dist/engine/expo-sqlite.d.ts",
      "default": "./dist/engine/expo-sqlite.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.3",
    "expo-sqlite": "^15.0.0 || ^16.0.0 || ^58.0.0",
    "libsql": "^0.5.29"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "libsql": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "sqlite3",
      "ref": "v2.7.3",
      "sha": "0cfccfc91c93afb11769dc7b830cb5d7ae2addcc"
    }
  ],
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
