{
  "name": "@blazetrails/thor",
  "version": "0.1.0",
  "description": "Port of the thor gem: a toolkit for building command-line interfaces",
  "type": "module",
  "main": "dist/thor.js",
  "types": "dist/thor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/thor.d.ts",
      "default": "./dist/thor.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
