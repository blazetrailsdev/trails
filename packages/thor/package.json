{
  "name": "@blazetrails/thor",
  "version": "0.1.0-alpha0.2",
  "description": "Port of the thor gem: a toolkit for building command-line interfaces",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/thor"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/thor#readme",
  "type": "module",
  "main": "dist/thor.js",
  "types": "dist/thor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/thor.d.ts",
      "default": "./dist/thor.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "thor",
      "ref": "v1.4.0",
      "sha": "518ae0f49bb1c3dc2226607c07da74b591759ed0"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
