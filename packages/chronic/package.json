{
  "name": "@blazetrails/chronic",
  "version": "0.1.0",
  "description": "Natural-language date parsing for Trails, mirroring the chronic gem",
  "type": "module",
  "main": "dist/chronic.js",
  "types": "dist/chronic.d.ts",
  "exports": {
    ".": {
      "types": "./dist/chronic.d.ts",
      "default": "./dist/chronic.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "mirrors": [
    {
      "source": "chronic",
      "ref": "v0.10.2",
      "sha": "7d3d82d38c991955526d0a45bede462f3f598319"
    }
  ]
}
