{
  "name": "@blazetrails/mail",
  "version": "0.1.0",
  "description": "Email parsing and generation, mirroring Ruby's mail gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "license": "MIT",
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  }
}
