{
  "name": "@blazetrails/activestorage",
  "version": "0.1.0",
  "description": "File attachments for Trails models, mirroring the activestorage gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/fixture-set": {
      "types": "./dist/types/fixture-set.d.ts",
      "default": "./dist/fixture-set.js"
    },
    "./testing/fixture-set.js": null,
    "./fixture-set": null,
    "./fixture-set.js": null,
    "./constants.fixture-set.generated": null,
    "./constants.fixture-set.generated.js": null,
    "./*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/globalid": "workspace:*",
    "@blazetrails/marcel": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/rack-test": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/mini-magick": "workspace:*",
    "@blazetrails/image-processing": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "peerDependencies": {
    "@blazetrails/image-processing": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@blazetrails/image-processing": {
      "optional": true
    }
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.2",
      "sha": "3235827585d87661942c91bc81f64f56d710f0b2"
    }
  ]
}
