{
  "name": "@blazetrails/mini-mime",
  "version": "0.1.0",
  "description": "MIME type lookup for Trails, mirroring the mini_mime gem",
  "type": "module",
  "main": "dist/mini-mime.js",
  "types": "dist/mini-mime.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mini-mime.d.ts",
      "default": "./dist/mini-mime.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && pnpm build:db",
    "build:db": "cp -R lib/db dist/"
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "mini_mime",
      "ref": "v1.1.5",
      "sha": "ad29352bf7b8fa547ea3058f2e97f3e8496f034a"
    }
  ]
}
