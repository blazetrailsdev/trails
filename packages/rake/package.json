{
  "name": "@blazetrails/rake",
  "version": "0.1.0",
  "description": "Port of the rake gem: a make-like build utility",
  "type": "module",
  "bin": {
    "rake": "./bin/rake.js"
  },
  "main": "dist/rake.js",
  "types": "dist/rake.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rake.d.ts",
      "default": "./dist/rake.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "rake",
      "ref": "v13.2.1",
      "sha": "d84f6ef7f3540a1d0e95fabe451ea3a16157791b"
    }
  ]
}
