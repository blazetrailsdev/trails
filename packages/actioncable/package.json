{
  "name": "@blazetrails/actioncable",
  "version": "0.1.0",
  "description": "Integrated WebSockets for Trails, mirroring the actioncable gem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/actioncable"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/actioncable#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/rackup": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*",
    "websocket-driver": ">=0.7.4"
  },
  "engines": {
    "node": ">=26"
  },
  "peerDependencies": {
    "@blazetrails/pg": "workspace:*",
    "pg": ">=8.19.0"
  },
  "peerDependenciesMeta": {
    "@blazetrails/pg": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/pg": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "@rails/actioncable": "8.0.200",
    "ioredis": "^6.0.0"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
