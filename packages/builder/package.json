{
  "name": "@blazetrails/builder",
  "version": "0.1.0-alpha0.1",
  "description": "XML markup builder for Trails, mirroring the builder gem",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/builder"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/builder#readme",
  "type": "module",
  "main": "dist/builder.js",
  "types": "dist/builder.d.ts",
  "exports": {
    ".": {
      "types": "./dist/builder.d.ts",
      "default": "./dist/builder.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "builder",
      "ref": "v3.3.0",
      "sha": "789896b306e36a5fe166388413b16e9323260601"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
