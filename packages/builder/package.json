{
  "name": "@blazetrails/builder",
  "version": "0.1.0",
  "description": "XML markup builder for Trails, mirroring the builder gem",
  "type": "module",
  "main": "dist/builder.js",
  "types": "dist/builder.d.ts",
  "exports": {
    ".": {
      "types": "./dist/builder.d.ts",
      "default": "./dist/builder.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
