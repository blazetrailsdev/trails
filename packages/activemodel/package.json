{
  "name": "@blazetrails/activemodel",
  "version": "0.1.0-alpha0.1",
  "description": "Attributes, validations, callbacks, and serialization, mirroring Ruby's ActiveModel",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/activemodel"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/activemodel#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./testing/lint.js": null,
    "./lint": null,
    "./lint.js": null,
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/bcrypt": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
