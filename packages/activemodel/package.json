{
  "name": "@blazetrails/activemodel",
  "version": "0.1.0-alpha0.2",
  "description": "Attributes, validations, callbacks, and serialization, mirroring Ruby's ActiveModel",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/activemodel"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/activemodel#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./testing/lint.js": null,
    "./lint": null,
    "./lint.js": null,
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "sideEffects": [
    "./dist/attribute-methods.js",
    "./dist/attribute-mutation-tracker.js",
    "./dist/attribute-set.js",
    "./dist/attribute-set/builder.js",
    "./dist/attribute.js",
    "./dist/attribute/user-provided-default.js",
    "./dist/attributes.js",
    "./dist/constants.generated.js",
    "./dist/conversion.js",
    "./dist/deprecator.js",
    "./dist/error.js",
    "./dist/errors.js",
    "./dist/forbidden-attributes-protection.js",
    "./dist/gem-version.js",
    "./dist/i18n.js",
    "./dist/index.js",
    "./dist/lint.js",
    "./dist/model.js",
    "./dist/namespaces.js",
    "./dist/naming.js",
    "./dist/nested-error.js",
    "./dist/secure-password.js",
    "./dist/serialization.js",
    "./dist/serializers/json.js",
    "./dist/translation.js",
    "./dist/type.js",
    "./dist/type/binary.js",
    "./dist/type/date-time.js",
    "./dist/type/date.js",
    "./dist/type/decimal.js",
    "./dist/type/float.js",
    "./dist/type/integer.js",
    "./dist/type/serialize-cast-value.js",
    "./dist/type/time.js",
    "./dist/type/value.js",
    "./dist/validations.js",
    "./dist/validations/acceptance.js",
    "./dist/validations/confirmation.js",
    "./dist/validations/exclusion.js",
    "./dist/validations/format.js",
    "./dist/validations/inclusion.js",
    "./dist/validations/length.js",
    "./dist/validations/numericality.js"
  ],
  "dependencies": {
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/bcrypt": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
