<h2 class="request-heading">Request</h2>
<% if (isParamsValid()) { %>
  <p><b>Parameters</b>:</p> <pre><%= debugParams(this.request.filteredParameters()) %></pre>
<% } %>

<div class="details">
  <div class="summary"><a href="#" onclick="return toggleSessionDump()">Toggle session dump</a></div>
  <div id="session_dump" class="hidden"><pre><%= debugHash(this.request.session) %></pre></div>
</div>

<div class="details">
  <div class="summary"><a href="#" onclick="return toggleEnvDump()">Toggle env dump</a></div>
  <div id="env_dump" class="hidden"><pre><%= debugHash(RubyCompat.slice(this.request.env, ...this.request.constructor.ENV_METHODS)) %></pre></div>
</div>

<h2 class="response-heading">Response</h2>
<p><b>Headers</b>:</p> <pre><%= debugHeaders(RubyCompat.rbObjIvarDefined(this, "@response") ? this.response.headers : {}) %></pre>
