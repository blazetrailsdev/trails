<%
  const cleanParams = isParamsValid() ? { ...this.request.filteredParameters() } : {};
  delete cleanParams["action"];
  delete cleanParams["controller"];

  const requestDump = RubyCompat.isEmpty(cleanParams) ? 'None' : RubyCompat.rbInspect(cleanParams).replaceAll(',', ",\n");
%>

Request parameters
<%= requestDump %>

Session dump
<%= debugHash(this.request.session) %>

Env dump
<%= debugHash(RubyCompat.slice(this.request.env, ...this.request.constructor.ENV_METHODS)) %>

Response headers
<%= RubyCompat.rbObjIvarDefined(this, "@response") ? RubyCompat.rbInspect(this.response.headers).replaceAll(',', ",\n") : 'None' %>
