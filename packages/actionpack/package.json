{
  "name": "@blazetrails/actionpack",
  "version": "0.1.0-alpha0.2",
  "description": "ActionController and ActionDispatch — mirroring Rails ActionPack",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blazetrailsdev/trails.git",
    "directory": "packages/actionpack"
  },
  "homepage": "https://github.com/blazetrailsdev/trails/tree/main/packages/actionpack#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./system-testing": {
      "types": "./dist/system-testing.d.ts",
      "default": "./dist/system-testing.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./action-dispatch/http/rack-cache": {
      "types": "./dist/action-dispatch/http/rack-cache.d.ts",
      "default": "./dist/action-dispatch/http/rack-cache.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "cp -R lib/action-dispatch/journey/visualizer dist/action-dispatch/journey/ && cp -R lib/action-dispatch/middleware/templates dist/action-dispatch/middleware/ && trails-tsc-views build --views dist/action-dispatch/middleware/templates --in-place && trails-tsc-views build --views dist/action-dispatch/journey/visualizer --in-place"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "peerDependencies": {
    "@blazetrails/rack-cache": "workspace:*",
    "playwright": ">=1.40.0",
    "vite": ">=7.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@blazetrails/rack-cache": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/rackup": "workspace:*",
    "@blazetrails/rack-session": "workspace:*",
    "@blazetrails/rack-test": "workspace:*",
    "ua-parser-js": "^2.0.9"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/rack-cache": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "vite": "^7.0.0"
  },
  "mirrors": [
    {
      "source": "rails",
      "ref": "v8.0.5.2",
      "sha": "235c597b100321b6bd2d62f8df63707f42b25b2d"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
