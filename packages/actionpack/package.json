{
  "name": "@blazetrails/actionpack",
  "version": "0.1.0",
  "description": "ActionController and ActionDispatch — mirroring Rails ActionPack",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp -R src/action-dispatch/journey/visualizer dist/action-dispatch/journey/ && cp -R src/action-dispatch/middleware/templates dist/action-dispatch/middleware/ && trails-tsc-views build --views dist/action-dispatch/middleware/templates --in-place && trails-tsc-views build --views dist/action-dispatch/journey/visualizer --in-place"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "vite": ">=7.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/activemodel": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/did-you-mean": "workspace:*",
    "@blazetrails/i18n": "workspace:*",
    "@blazetrails/nokogiri": "workspace:*",
    "@blazetrails/rack": "workspace:*",
    "@blazetrails/rack-session": "workspace:*",
    "@blazetrails/rack-test": "workspace:*",
    "ua-parser-js": "^2.0.9"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@blazetrails/trails-tsc": "workspace:*",
    "vite": "^7.0.0"
  }
}
