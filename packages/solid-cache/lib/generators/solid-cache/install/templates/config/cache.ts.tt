import { Trails } from "@blazetrails/trailties";

const defaults = {
  storeOptions: {
    // Cap age of oldest cache entry to fulfill retention policies
    // maxAge: 60 * 24 * 60 * 60,
    maxSize: 256 * 1024 * 1024,
    namespace: Trails.env.toString(),
  },
};

export default {
  development: {
    ...defaults,
  },

  test: {
    ...defaults,
  },

  production: {
    database: "cache",
    ...defaults,
  },
};
