{
  "name": "@blazetrails/solid-cache",
  "version": "0.1.0",
  "description": "Database-backed Active Support cache store for Trails, mirroring the solid_cache gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "node -e \"require('fs').cpSync('lib/generators/solid-cache/install/templates', 'dist/generators/solid-cache/install/templates', { recursive: true })\" && trails-tsc-views build-templates dist/generators"
  },
  "dependencies": {
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/arel": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "solid_cache",
      "ref": "v1.0.7",
      "sha": "411771527afdc7b8f91b79b15ff12680d1a628a4"
    }
  ],
  "devDependencies": {
    "@blazetrails/trails-tsc": "workspace:*"
  }
}
