{
  "name": "@blazetrails/solid-cable",
  "version": "0.1.0",
  "description": "Database-backed Action Cable backend for Trails, mirroring the solid_cable gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && pnpm build:templates",
    "build:templates": "node -e \"for (const g of ['install', 'update']) require('fs').cpSync('lib/generators/solid-cable/' + g + '/templates', 'dist/generators/solid-cable/' + g + '/templates', { recursive: true })\" && trails-tsc-views build-templates dist/generators"
  },
  "dependencies": {
    "@blazetrails/actioncable": "workspace:*",
    "@blazetrails/activejob": "workspace:*",
    "@blazetrails/activerecord": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/arel": "workspace:*",
    "@blazetrails/date": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@blazetrails/vitest-matchers": "workspace:*",
    "@blazetrails/trails-tsc": "workspace:*"
  }
}
