{
  "name": "@blazetrails/vite-trails",
  "version": "0.1.0",
  "description": "Vite tag helpers and engine for Trails, mirroring the vite_rails gem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc"
  },
  "license": "MIT",
  "dependencies": {
    "@blazetrails/actionpack": "workspace:*",
    "@blazetrails/activesupport": "workspace:*",
    "@blazetrails/rake": "workspace:*",
    "@blazetrails/ruby-compat": "workspace:*",
    "@blazetrails/trailties": "workspace:*",
    "@blazetrails/vite-assets": "workspace:*"
  },
  "devDependencies": {
    "@blazetrails/actionview": "workspace:*",
    "@blazetrails/stimulus": "workspace:*",
    "@blazetrails/vitest-matchers": "workspace:*",
    "vite": "^7.3.1",
    "vite-plugin-ruby": "^5.2.6"
  },
  "engines": {
    "node": ">=26"
  },
  "mirrors": [
    {
      "source": "vite_ruby",
      "ref": "vite_ruby@3.11.1",
      "sha": "77de9ea2b94044d72622f72d44d392953843a1d7"
    }
  ]
}
